{
  "name": "cloud-simulator-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end + system-behaviour test suite for the cloud simulation platform",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:behaviour": "playwright test --project=chromium tests/03 tests/04 tests/05",
    "test:debug": "PWDEBUG=1 playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
